APP_NAME="Clínica Santa Lucía"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_citas_medicas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (HU04) por la API de Gmail (Railway bloquea SMTP saliente).
# Local: MAIL_MAILER=log (los correos se escriben en storage/logs).
# Producción: MAIL_MAILER=failover (Gmail y, si falla, log) + las 3 credenciales OAuth de Google Cloud.
# MAIL_FROM_ADDRESS debe ser el mismo Gmail que autorizó el token (Gmail ignora otros remitentes).
MAIL_MAILER=log
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM_ADDRESS="tu_correo@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Datos de la clínica (ver config/clinica.php)
CLINICA_NOMBRE="Clínica Santa Lucía"
CLINICA_CIUDAD=Arequipa
CLINICA_CELULAR="900 000 000"
CLINICA_TELEFONO="(054) 000 000"
CLINICA_DIRECCION="Av. Principal 123, Arequipa"
CLINICA_CORREO=contacto@clinicasantalucia.pe

# Bloqueo temporal tras intentos fallidos de inicio de sesión (HU01)
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15

# Asistente virtual (ver config/chatbot.php): URL del motor NLP de Python y umbrales de confianza.
# Por encima de UMBRAL_CONFIANZA acepta la intención; entre ambos pregunta "¿Quisiste decir…?"; por debajo no entiende.
CHATBOT_NLP_URL=http://127.0.0.1:8001
CHATBOT_UMBRAL_CONFIANZA=0.0
CHATBOT_UMBRAL_ACLARACION=-0.5

# Citas: anticipación mínima (horas) para que el paciente cancele, y correo de confirmación al reservar
CITAS_HORAS_MIN_CANCELACION=24
CITAS_CORREO_CONFIRMACION=true
